rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is the owner of a document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Check if user is the owner of a wedding
    function isWeddingOwner(weddingId) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/weddings/$(weddingId)).data.ownerId == request.auth.uid;
    }
    
    // Check if user is a super user
    function isSuperUser() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_user';
    }
    
    // Users collection rules
    match /users/{userId} {
      // Allow read access to own user data or public read for certain fields
      allow read: if true;
      
      // Allow create/write operations for authenticated users on their own documents
      allow create: if isAuthenticated() && request.auth.uid == userId;
      
      // Allow users to update their own documents
      allow update: if isAuthenticated() && request.auth.uid == userId;
      
      // Allow deletion of own documents
      allow delete: if isAuthenticated() && request.auth.uid == userId;
      
      // Allow access to subcollections of users
      match /{subcollection}/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Weddings collection rules
    match /weddings/{weddingId} {
      // Allow read access for public weddings (no authentication required)
      // OR if user is authenticated and is the owner
      allow read: if resource.data.isPublic == true || request.auth.uid == resource.data.ownerId;
      
      // Allow list operations (needed for queries like getFeaturedWeddingWebsites)
      // This allows unauthenticated users to query for public weddings
      allow list: if true;
      
      // Allow create if user is authenticated
      allow create: if isAuthenticated();
      
      // Allow update/delete if user is the owner
      allow update, delete: if isAuthenticated() && request.auth.uid == resource.data.ownerId;
      
      // Allow access to weddings subcollections
      match /{subcollection}/{document=**} {
        allow read: if true;
        allow write: if isWeddingOwner(weddingId);
      }
      
      // Todo items subcollection
      match /tasks/{taskId} {
        // Allow reading todos if authenticated user is the wedding owner or for any authenticated user
        allow read: if isAuthenticated();
        
        // Allow creating/updating/deleting todos if authenticated user is the wedding owner
        allow create, update, delete: if isWeddingOwner(weddingId);
      }
      
      // Specific rules for wishes subcollection
      match /wishes/{wishId} {
        // Allow reading all wishes if authenticated user is the wedding owner
        // Otherwise only allow reading approved wishes
        allow read: if resource.data.approved == true || isWeddingOwner(weddingId);
        
        // Allow creating wishes by anyone (they'll be marked as unapproved initially)
        allow create: if request.resource.data.approved == false;
        
        // Only allow updating by the wedding owner
        allow update: if isWeddingOwner(weddingId);
        
        // Only allow deleting by the wedding owner
        allow delete: if isWeddingOwner(weddingId);
      }
      
      // Guest list subcollection
      match /guests/{guestId} {
        // Allow reading guests if authenticated user is the wedding owner
        allow read: if isWeddingOwner(weddingId);
        
        // Allow creating/updating/deleting guests if authenticated user is the wedding owner
        allow create, update, delete: if isWeddingOwner(weddingId);
      }
      
      // Money tracking subcollection
      match /transactions/{transactionId} {
        // Allow reading transactions if authenticated user is the wedding owner
        allow read: if isWeddingOwner(weddingId);
        
        // Allow creating/updating/deleting transactions if authenticated user is the wedding owner
        allow create, update, delete: if isWeddingOwner(weddingId);
      }
    }
    
    // Advertisements collection
    match /advertisements/{adId} {
      // Allow reading advertisements for everyone (including list operations)
      allow read, list: if true;
      
      // Only super users can write advertisements
      allow write: if isSuperUser();
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      // Guest access - for unauthenticated users (visibility = 'guest')
      allow read: if resource.data.visibility == 'guest' && 
                     resource.data.isActive == true;
      
      // User access - for authenticated users (visibility = 'guest' or 'user')
      allow read: if request.auth != null && 
                     resource.data.isActive == true &&
                     resource.data.visibility in ['guest', 'user'];
      
      // Admin read access for all notifications
      allow read: if isSuperUser();
      
      // Only super users can write notifications
      allow write: if isSuperUser();
    }
    
    // Template configurations collection
    match /templateConfigs/{configId} {
      // Public read access for active configurations
      allow read: if resource.data.isActive == true;
      
      // Admin read access for all configurations
      allow read: if isSuperUser();
      
      // Only super users can write configurations
      allow write: if isSuperUser();
    }
    
    // RSVP responses
    match /rsvps/{rsvpId} {
      allow read, write: if true; // Public access for RSVP responses
    }
    
    // Attendances collection rules
    match /attendances/{attendanceId} {
      // Anyone can submit an attendance (for RSVP)
      allow create: if true;
      
      // Only authenticated users can read attendance records of their weddings
      allow read: if isAuthenticated() && (
        // This should match how the wedding owner is determined in your app
        get(/databases/$(database)/documents/weddings/$(resource.data.weddingId)).data.ownerId == request.auth.uid
      );
      
      // Only wedding owners can update attendances
      allow update, delete: if isAuthenticated() && (
        get(/databases/$(database)/documents/weddings/$(resource.data.weddingId)).data.ownerId == request.auth.uid
      );
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
} 